# =============================================================================
# Sayan Adhikary Portfolio - Backend Environment Example
# Copy this file to .env and configure variables for your deployment.
# =============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS (set to your live portfolio link in production)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (leave default for local JSON store fallback, or provide MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Admin Panel Secret Password
ADMIN_PASSWORD=admin123
